{
  "name": "release-tools",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "release-tools",
      "license": "MIT",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "node_modules/dts-js-extensions": {
      "resolved": "packages/dts-js-extensions",
      "link": true
    },
    "packages/dts-js-extensions": {
      "version": "0.1.0",
      "license": "MIT",
      "bin": {
        "dts-js-extensions": "cli.js"
      },
      "engines": {
        "node": ">=20"
      }
    }
  }
}
